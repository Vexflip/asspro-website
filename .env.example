# SMTP credentials for the contact & adhésion forms.
# Copy this file to `.env.local` and fill in real values (never commit .env.local).

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=

# "From" address used for all outgoing mail.
MAIL_FROM="ASSPRO <no-reply@asspro.fr>"

# Where form submissions are delivered.
CONTACT_TO=contact@asspro.fr
ADHESION_TO=adhesion@asspro.fr   # optional, falls back to CONTACT_TO if unset
