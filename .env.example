# Copy this file to `.env.local` and fill in real values (never commit .env.local).

# Canonical site URL (no trailing slash) used for metadata, robots.txt and the
# sitemap. Defaults to https://asspro.fr; override for staging/preview domains.
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time. In Docker, pass it as a
# build arg (see Dockerfile) rather than at runtime — a runtime value is ignored.
NEXT_PUBLIC_SITE_URL=https://asspro.fr

# SMTP credentials for the contact & adhésion forms.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=

# "From" address used for all outgoing mail.
MAIL_FROM="ASSPRO <no-reply@asspro.fr>"

# Where form submissions are delivered.
CONTACT_TO=contact@asspro.fr
ADHESION_TO=adhesion@asspro.fr   # optional, falls back to CONTACT_TO if unset

# ── Deployment note ────────────────────────────────────────────────────────
# The form rate limiter keys off the client IP taken from the X-Forwarded-For
# header. This is only trustworthy if the reverse proxy in front of the app
# STRIPS any client-supplied X-Forwarded-For and sets its own; otherwise the
# per-IP limit can be bypassed with a spoofed header. Configure the proxy
# accordingly (e.g. nginx `proxy_set_header X-Forwarded-For $remote_addr;`).
