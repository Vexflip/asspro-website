# Template for every environment — copy it and fill in real values.
# Never commit the resulting file (`.env*` is git-ignored).
#
#   Développement :  cp .env.example .env.local
#   Docker Compose : cp .env.example .env
#
# ── Deux familles de variables ─────────────────────────────────────────────
# NEXT_PUBLIC_*  : lues au moment du BUILD et figées dans le bundle.
#                  Toutes sont OBLIGATOIRES — le build échoue si l'une manque
#                  (voir src/lib/org.ts). Les modifier impose de reconstruire
#                  l'image : changer la valeur au runtime n'a aucun effet.
# Les autres     : lues au RUNTIME par le serveur (RCS). Modifiables sans
#                  rebuild, mais le conteneur refuse de démarrer sans elles
#                  (voir src/instrumentation.ts).

# ── Site ────────────────────────────────────────────────────────────────────
# URL canonique, sans slash final (métadonnées, robots.txt, sitemap).
NEXT_PUBLIC_SITE_URL=https://asspro.fr

# ── Éditeur / association (page Mentions légales) ───────────────────────────
NEXT_PUBLIC_ORG_LEGAL_NAME="Association pour la Prévention du Risque Opératoire (ASSPRO)"
NEXT_PUBLIC_ORG_LEGAL_FORM="Association loi 1901"
NEXT_PUBLIC_ORG_SIREN="527 924 658"
NEXT_PUBLIC_ORG_DECLARATION="Déclarée à la Préfecture de l'Isère le 5 septembre 1997 — n° 0381025802"
NEXT_PUBLIC_ORG_DIRECTOR="Monsieur Patrick-Georges YAVORDIOS, en qualité de Président de l'Association"

# ── Coordonnées affichées (en-tête, pied de page, contact, mentions) ────────
NEXT_PUBLIC_CONTACT_EMAIL=contact@asspro.fr
# Format d'affichage libre ; le lien `tel:` et le format international du
# JSON-LD en sont dérivés automatiquement (un numéro commençant par 0 est
# considéré comme français et préfixé +33).
NEXT_PUBLIC_PHONE_MAIN="01 55 07 15 15"
NEXT_PUBLIC_PHONE_EMERGENCY="04 85 85 85 85"

# ── Adresse du siège social ─────────────────────────────────────────────────
NEXT_PUBLIC_ADDRESS_STREET="60 rue de la Chaussée d'Antin"
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=75009
NEXT_PUBLIC_ADDRESS_CITY=Paris
# Code pays ISO 3166-1 alpha-2, utilisé par le JSON-LD.
NEXT_PUBLIC_ADDRESS_COUNTRY=FR

# ── Réseaux sociaux ─────────────────────────────────────────────────────────
# Affiché dans la barre de navigation et le pied de page, et déclaré en
# `sameAs` dans le JSON-LD.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/asspro/

# ── Hébergeur — mention obligatoire (LCEN, loi n° 2004-575) ─────────────────
# ⚠️ À METTRE À JOUR avec l'hébergeur réel du site.
NEXT_PUBLIC_HOST_NAME=o2switch
NEXT_PUBLIC_HOST_ADDRESS="Chem. des Pardiaux, 63000 Clermont-Ferrand, France"
NEXT_PUBLIC_HOST_PHONE="04 44 44 60 40"
NEXT_PUBLIC_HOST_URL=https://www.o2switch.fr

# ── Carte de la page contact ────────────────────────────────────────────────
# URL d'intégration Google Maps. Elle encode les coordonnées GPS : à régénérer
# (Google Maps → Partager → Intégrer une carte) si l'adresse change.
# Le CSP n'autorise que https://www.google.com en `frame-src` (next.config.ts).
NEXT_PUBLIC_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.2158371393206!2d2.3352349!3d48.8755!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e3eed81e7c5%3A0x0!2s60+Rue+de+la+Chauss%C3%A9e+d'Antin%2C+75009+Paris!5e0!3m2!1sfr!2sfr!4v1"

# ── RCS (runtime) — formulaires contact & adhésion ──────────────────────────
# « Raven Notification Service » : le service de notifications interne de
# Branchet, par lequel transitent tous les e-mails du site.
#
# ⚠️ Il n'est joignable que depuis le réseau interne Branchet. Déployée hors de
# ce réseau, l'application ne peut plus envoyer d'e-mail.
#
# Swagger : ${RCS_BASE_URL}/api/docs/ — en recette, les messages envoyés sont
# consultables dans Maildev sur http://tb-07.branchet.local:8025/
RCS_BASE_URL=http://tb-07.branchet.local:8097
RCS_API_KEY=

# Utilisateur appelant, transmis à chaque notification. L'application appelante,
# elle, n'est pas à renseigner : le service la déduit de la clé d'API, qui porte
# aussi les permissions de canal.
RCS_CALLING_USER=website

# ── Destinataires ───────────────────────────────────────────────────────────
# RCS impose son propre expéditeur (noreply@branchet.fr) et n'expose pas de
# « répondre à » : ces adresses sont donc aussi affichées dans le corps des
# messages de confirmation, seul moyen pour le visiteur de nous répondre.
CONTACT_TO=contact@asspro.fr
ADHESION_TO=adhesion@asspro.fr   # optional, falls back to CONTACT_TO if unset

# ── Deployment note ────────────────────────────────────────────────────────
# The form rate limiter keys off the client IP taken from the X-Forwarded-For
# header. This is only trustworthy if the reverse proxy in front of the app
# STRIPS any client-supplied X-Forwarded-For and sets its own; otherwise the
# per-IP limit can be bypassed with a spoofed header. Configure the proxy
# accordingly (e.g. nginx `proxy_set_header X-Forwarded-For $remote_addr;`).
